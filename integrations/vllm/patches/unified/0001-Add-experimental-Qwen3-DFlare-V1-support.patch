+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import torch
+from torch import nn
+from transformers import Qwen3Config
+
+from vllm.model_executor.models.qwen3_dflare import DFlareQwen3Model
+from vllm.transformers_utils.configs.eagle import EAGLEConfig
+
+
+def test_dflare_layerwise_fusion_keeps_distinct_draft_contexts() -> None:
+    model = DFlareQwen3Model.__new__(DFlareQwen3Model)
+    nn.Module.__init__(model)
+    model.config = SimpleNamespace(
+        hidden_size=2,
+        dflash_config={"target_layer_ids": [1, 5]},
+    )
+    model.hidden_norm = nn.Identity()
+    model.layer_fusion_weights = nn.Parameter(torch.zeros(2, 2))
+    model._fusion_weights = torch.tensor([[1.0, 0.0], [0.0, 1.0]])
+
+    concatenated = torch.tensor([[1.0, 2.0, 10.0, 20.0]])
+    fused = model.fuse_target_hidden_states(concatenated)
+
+    assert fused.shape == (1, 2, 2)
+    torch.testing.assert_close(fused[0, 0], torch.tensor([1.0, 2.0]))
+    torch.testing.assert_close(fused[0, 1], torch.tensor([10.0, 20.0]))
+
+
+def test_dflare_eagle_wrapper_preserves_checkpoint_contract() -> None:
+    draft = Qwen3Config(
+        architectures=["QwenDFlareDraftModel"],
+        dflash_config={
+            "mask_token_id": 151669,
+            "target_layer_ids": [1, 5, 9],
+        },
+    )
+
+    wrapped = EAGLEConfig(draft, method="dflare", model_type="eagle")
+
+    assert wrapped.architectures == ["QwenDFlareDraftModel"]
+    assert wrapped.eagle_aux_hidden_state_layer_ids == [2, 6, 10]
