diff --git a/vllm/model_executor/models/qwen3_dflare.py b/vllm/model_executor/models/qwen3_dflare.py
new file mode 100644
index 000000000..1dd288b3a
--- /dev/null
+++ b/vllm/model_executor/models/qwen3_dflare.py
@@ -0,0 +1,387 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Experimental Qwen3 DFlare model built on the DFlash execution path.
+
+This intentionally reuses DFlash query attention and only specializes the two
+architectural differences in the released DFlare checkpoint: layer-wise target
+feature fusion and per-layer target K/V projections.
+"""
+
+from collections.abc import Iterable
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+from transformers import Qwen3Config
+
+from vllm import _custom_ops as ops
+from vllm.compilation.decorators import support_torch_compile
+from vllm.config import CacheConfig, VllmConfig, get_current_vllm_config
+from vllm.model_executor.layers.layernorm import RMSNorm
+from vllm.model_executor.layers.linear import QKVParallelLinear
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.model_executor.layers.quantization.base_config import QuantizationConfig
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    VocabParallelEmbedding,
+)
+from vllm.model_executor.model_loader.weight_utils import (
+    default_weight_loader,
+    maybe_remap_kv_scale_name,
+)
+from vllm.transformers_utils.config import set_default_rope_theta
+from vllm.v1.attention.backend import AttentionType
+
+from .qwen2 import Qwen2MLP as Qwen3MLP
+from .qwen3_dflash import (
+    DFlashQwen3Attention,
+    DFlashQwen3ForCausalLM,
+    DFlashQwen3Model,
+)
+from .utils import get_draft_quant_config, maybe_prefix
+
+
+class DFlareQwen3Attention(DFlashQwen3Attention):
+    """DFlash attention with separate projections for target context K/V."""
+
+    def __init__(
+        self,
+        hidden_size: int,
+        num_heads: int,
+        num_kv_heads: int,
+        rope_parameters: dict,
+        max_position: int = 4096 * 32,
+        head_dim: int | None = None,
+        rms_norm_eps: float = 1e-6,
+        attention_bias: bool = False,
+        cache_config: CacheConfig | None = None,
+        quant_config: QuantizationConfig | None = None,
+        prefix: str = "",
+        attn_type: str = "decoder",
+    ) -> None:
+        super().__init__(
+            hidden_size=hidden_size,
+            num_heads=num_heads,
+            num_kv_heads=num_kv_heads,
+            rope_parameters=rope_parameters,
+            max_position=max_position,
+            head_dim=head_dim,
+            rms_norm_eps=rms_norm_eps,
+            attention_bias=attention_bias,
+            cache_config=cache_config,
+            quant_config=quant_config,
+            prefix=prefix,
+            attn_type=attn_type,
+        )
+        self.kv_target_proj = QKVParallelLinear(
+            hidden_size,
+            self.head_dim,
+            0,
+            self.total_num_kv_heads,
+            bias=attention_bias,
+            quant_config=quant_config,
+            prefix=f"{prefix}.kv_target_proj",
+        )
+
+
+class DFlareQwen3DecoderLayer(nn.Module):
+    """DFlash decoder layer using DFlare's target-context projections."""
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        *,
+        config: Qwen3Config,
+        cache_config: CacheConfig | None = None,
+        quant_config: QuantizationConfig | None = None,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        self.hidden_size = config.hidden_size
+        set_default_rope_theta(config, default_theta=1000000)
+        self.self_attn = DFlareQwen3Attention(
+            hidden_size=config.hidden_size,
+            num_heads=config.num_attention_heads,
+            max_position=config.max_position_embeddings,
+            num_kv_heads=config.num_key_value_heads,
+            rms_norm_eps=config.rms_norm_eps,
+            attention_bias=getattr(config, "attention_bias", False),
+            head_dim=getattr(config, "head_dim", None),
+            cache_config=cache_config,
+            quant_config=quant_config,
+            rope_parameters=config.rope_parameters,
+            prefix=f"{prefix}.self_attn",
+            attn_type=AttentionType.DECODER,
+        )
+        self.mlp = Qwen3MLP(
+            hidden_size=config.hidden_size,
+            intermediate_size=config.intermediate_size,
+            hidden_act=config.hidden_act,
+            quant_config=quant_config,
+            prefix=f"{prefix}.mlp",
+        )
+        self.input_layernorm = RMSNorm(
+            config.hidden_size,
+            eps=config.rms_norm_eps,
+        )
+        self.post_attention_layernorm = RMSNorm(
+            config.hidden_size,
+            eps=config.rms_norm_eps,
+        )
+
+    def forward(
+        self,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+        residual: torch.Tensor | None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if residual is None:
+            residual = hidden_states
+            hidden_states = self.input_layernorm(hidden_states)
+        else:
+            hidden_states, residual = self.input_layernorm(hidden_states, residual)
+        hidden_states = self.self_attn(
+            positions=positions,
+            hidden_states=hidden_states,
+        )
+        hidden_states, residual = self.post_attention_layernorm(hidden_states, residual)
+        return self.mlp(hidden_states), residual
+
+
+@support_torch_compile
+class DFlareQwen3Model(DFlashQwen3Model):
+    """DFlash execution with layer-wise fusion and heterogeneous context K/V."""
+
+    def __init__(
+        self,
+        *,
+        vllm_config: VllmConfig,
+        start_layer_id: int = 0,
+        prefix: str = "",
+    ) -> None:
+        nn.Module.__init__(self)
+        self.config = vllm_config.speculative_config.draft_model_config.hf_config
+        self.vocab_size = self.config.vocab_size
+        self.quant_config = get_draft_quant_config(vllm_config)
+        self.use_aux_hidden_state = True
+        self.embed_tokens = VocabParallelEmbedding(
+            self.config.vocab_size,
+            self.config.hidden_size,
+            prefix=maybe_prefix(prefix, "embed_tokens"),
+        )
+        current = get_current_vllm_config()
+        self.layers = nn.ModuleList(
+            [
+                DFlareQwen3DecoderLayer(
+                    current,
+                    config=self.config,
+                    cache_config=current.cache_config,
+                    quant_config=self.quant_config,
+                    prefix=maybe_prefix(prefix, f"layers.{i + start_layer_id}"),
+                )
+                for i in range(self.config.num_hidden_layers)
+            ]
+        )
+        target_layers = self.dflare_config["target_layer_ids"]
+        self.layer_fusion_weights = nn.Parameter(
+            torch.zeros(self.config.num_hidden_layers, len(target_layers))
+        )
+        self.hidden_norm = RMSNorm(
+            self.config.hidden_size,
+            eps=self.config.rms_norm_eps,
+        )
+        self.norm = RMSNorm(
+            self.config.hidden_size,
+            eps=self.config.rms_norm_eps,
+        )
+
+    @property
+    def dflare_config(self) -> dict:
+        return getattr(self.config, "dflash_config", None) or {}
+
+    def _build_fused_kv_buffers(self) -> None:
+        layers_attn = [layer.self_attn for layer in self.layers]
+        attn0 = layers_attn[0]
+
+        weights = torch.stack([attn.kv_target_proj.weight for attn in layers_attn])
+        self._target_kv_weight = weights.transpose(1, 2).contiguous()
+        if attn0.kv_target_proj.bias is None:
+            self._target_kv_bias = None
+        else:
+            self._target_kv_bias = torch.stack(
+                [attn.kv_target_proj.bias for attn in layers_attn]
+            ).unsqueeze(1)
+        self._fusion_weights = F.softmax(self.layer_fusion_weights.float(), dim=-1).to(
+            self.layer_fusion_weights.dtype
+        )
+        self._k_norm_weights = [attn.k_norm.weight.data for attn in layers_attn]
+        self._rope_head_size = attn0.rotary_emb.head_size
+        self._rope_cos_sin_cache = attn0.rotary_emb.cos_sin_cache
+        self._rope_is_neox = attn0.rotary_emb.is_neox_style
+        self._num_attn_layers = len(layers_attn)
+        self._kv_size = attn0.kv_size
+        self._head_dim = attn0.head_dim
+        self._num_kv_heads = attn0.num_kv_heads
+        self._rms_norm_eps = attn0.q_norm.variance_epsilon
+        self._attn_layers = [attn.attn for attn in layers_attn]
+
+        for attn in layers_attn[1:]:
+            assert (
+                attn.rotary_emb.head_size == self._rope_head_size
+                and attn.rotary_emb.is_neox_style == self._rope_is_neox
+                and attn.kv_size == self._kv_size
+                and attn.head_dim == self._head_dim
+                and attn.num_kv_heads == self._num_kv_heads
+            ), "DFlare context precompute requires homogeneous draft attention"
+
+    def fuse_target_hidden_states(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        target_count = len(self.dflare_config["target_layer_ids"])
+        hidden_size = self.config.hidden_size
+        target_states = hidden_states.reshape(-1, target_count, hidden_size)
+        weights = getattr(
+            self,
+            "_fusion_weights",
+            F.softmax(self.layer_fusion_weights.float(), dim=-1).to(
+                hidden_states.dtype
+            ),
+        )
+        fused = torch.einsum("nth,dt->ndh", target_states, weights)
+        shape = fused.shape
+        return self.hidden_norm(fused.reshape(-1, hidden_size)).reshape(shape)
+
+    def precompute_and_store_context_kv(
+        self,
+        context_states: torch.Tensor,
+        context_positions: torch.Tensor,
+        context_slot_mapping: torch.Tensor | None = None,
+    ) -> None:
+        if not hasattr(self, "_num_attn_layers"):
+            self._build_fused_kv_buffers()
+        if context_states.ndim == 2:
+            # DFlash's memory-profile dummy path supplies one context tensor.
+            # Expanding it models DFlare's per-layer K/V memory without changing
+            # real requests, which arrive as [N, D, H] after layer-wise fusion.
+            context_states = context_states.unsqueeze(1).expand(
+                -1, self._num_attn_layers, -1
+            )
+        if context_states.ndim != 3:
+            raise ValueError("DFlare context states must have shape [N, D, H]")
+
+        layer_states = context_states.permute(1, 0, 2)
+        num_layers, num_context, _ = layer_states.shape
+        all_kv = torch.bmm(layer_states, self._target_kv_weight)
+        if self._target_kv_bias is not None:
+            all_kv = all_kv + self._target_kv_bias
+        all_k, all_v = all_kv.chunk(2, dim=-1)
+        all_k = all_k.view(num_layers, num_context, self._num_kv_heads, self._head_dim)
+        all_v = all_v.view(num_layers, num_context, self._num_kv_heads, self._head_dim)
+
+        normalized_k = torch.empty_like(all_k)
+        for layer_index in range(num_layers):
+            ops.rms_norm(
+                normalized_k[layer_index],
+                all_k[layer_index],
+                self._k_norm_weights[layer_index],
+                self._rms_norm_eps,
+            )
+
+        flat_k = normalized_k.view(num_layers * num_context, self._kv_size)
+        rope_cache = self._rope_cos_sin_cache
+        if rope_cache.dtype != flat_k.dtype:
+            rope_cache = rope_cache.to(dtype=flat_k.dtype)
+        ops.rotary_embedding(
+            context_positions.repeat(num_layers),
+            flat_k,
+            None,
+            self._rope_head_size,
+            rope_cache,
+            self._rope_is_neox,
+        )
+        if context_slot_mapping is None:
+            return
+
+        final_k = flat_k.view(
+            num_layers, num_context, self._num_kv_heads, self._head_dim
+        )
+        for layer_index, attn in enumerate(self._attn_layers):
+            attn.impl.do_kv_cache_update(
+                attn,
+                final_k[layer_index],
+                all_v[layer_index],
+                attn.kv_cache,
+                context_slot_mapping,
+            )
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        stacked_params_mapping = [
+            (".qkv_proj", ".q_proj", "q"),
+            (".qkv_proj", ".k_proj", "k"),
+            (".qkv_proj", ".v_proj", "v"),
+            (".kv_target_proj", ".k_proj_target", "k"),
+            (".kv_target_proj", ".v_proj_target", "v"),
+            (".gate_up_proj", ".gate_proj", 0),
+            (".gate_up_proj", ".up_proj", 1),
+        ]
+        params = dict(self.named_parameters())
+        loaded: set[str] = set()
+        for name, loaded_weight in weights:
+            if "midlayer." in name:
+                name = name.replace("midlayer.", "layers.0.")
+            if "scale" in name:
+                name = maybe_remap_kv_scale_name(name, params)
+                if name is None:
+                    continue
+            for param_name, weight_name, shard_id in stacked_params_mapping:
+                if weight_name not in name:
+                    continue
+                if param_name == ".qkv_proj" and "_target" in name:
+                    continue
+                name = name.replace(weight_name, param_name)
+                param = params[name]
+                param.weight_loader(param, loaded_weight, shard_id)
+                break
+            else:
+                param = params[name]
+                loader = getattr(param, "weight_loader", default_weight_loader)
+                loader(param, loaded_weight)
+            loaded.add(name)
+        return loaded
+
+
+class DFlareQwen3ForCausalLM(DFlashQwen3ForCausalLM):
+    """Qwen3 DFlare drafter for vLLM's lossless DFlash verifier path."""
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        nn.Module.__init__(self)
+        self.config = vllm_config.speculative_config.draft_model_config.hf_config
+        if getattr(self.config, "draft_vocab_size", None) is None:
+            self.config.draft_vocab_size = self.config.vocab_size
+        target_layer_num = vllm_config.model_config.get_num_layers(
+            vllm_config.parallel_config
+        )
+        self.model = DFlareQwen3Model(
+            vllm_config=vllm_config,
+            prefix=maybe_prefix(prefix, "model"),
+            start_layer_id=target_layer_num,
+        )
+        logit_scale = getattr(self.config, "logit_scale", 1.0)
+        self.lm_head = ParallelLMHead(
+            self.config.draft_vocab_size,
+            self.config.hidden_size,
+            prefix=maybe_prefix(prefix, "lm_head"),
+        )
+        self.logits_processor = LogitsProcessor(
+            self.config.draft_vocab_size,
+            scale=logit_scale,
+        )
+        target_vocab_size = vllm_config.model_config.get_vocab_size()
+        if self.config.draft_vocab_size != target_vocab_size:
+            self.draft_id_to_target_id = nn.Parameter(
+                torch.zeros(self.config.draft_vocab_size, dtype=torch.long),
+                requires_grad=False,
+            )
+        else:
+            self.draft_id_to_target_id = None
+
+    def combine_hidden_states(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return self.model.fuse_target_hidden_states(hidden_states)
